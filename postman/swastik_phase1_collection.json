{
  "info": {
    "_postman_id": "swastik-phase1-collection-id",
    "name": "Swastik Phase 1 Backend API",
    "description": "Postman Collection for testing Swastik REST API (Dedicated Admin Login, Customer Auth, Categories with Sectors, Rich Product Catalog with SKUs & JSON attributes, Admin CRUD).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Admin Login (Dedicated)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"Swastikartisanbakehouse@gmail.com\",\n  \"password\": \"ASHISH.kc1999\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/admin/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "admin", "login", ""]
            },
            "description": "Dedicated Admin Login endpoint. Verifies user is staff/superuser and returns admin_token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"admin_token\", jsonData.token);",
                  "    console.log(\"Saved admin_token:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Customer Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@swastik.com\",\n  \"password\": \"CustomerPass123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            },
            "description": "Login customer with email & password to retrieve Auth Token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"auth_token\", jsonData.token);",
                  "    console.log(\"Saved auth_token:\", jsonData.token);",
