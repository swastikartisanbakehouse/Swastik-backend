{
  "info": {
    "_postman_id": "swastik-phase1-collection-id",
    "name": "Swastik Phase 1 Backend API",
    "description": "Postman Collection for testing Swastik Phase 1 REST API (Customer Auth, Categories with Sectors, Rich Product Catalog with SKUs & JSON attributes, Admin CRUD).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Customer\",\n  \"email\": \"customer@swastik.com\",\n  \"mobile_number\": \"9876543210\",\n  \"whatsapp_number\": \"9876543210\",\n  \"password\": \"CustomerPass123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            },
            "description": "Register a new customer account and receive token payload."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"auth_token\", jsonData.token);",
                  "    console.log(\"Saved auth_token:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Login Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@swastik.com\",\n  \"password\": \"CustomerPass123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            },
            "description": "Login customer with email & password to retrieve Auth Token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"auth_token\", jsonData.token);",
                  "    console.log(\"Updated auth_token:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@swastik.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            },
            "description": "Login default seeded admin account (admin@swastik.com / Admin@12345) to retrieve Admin Token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"admin_token\", jsonData.token);",
                  "    console.log(\"Saved admin_token:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me", ""]
            },
            "description": "Get profile of logged-in user including mobile, whatsapp & saved addresses."
          }
        },
        {
          "name": "5. Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout", ""]
            },
            "description": "Invalidates active token."
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "1. List Public Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/categories/",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", ""]
            },
            "description": "List all active business categories (Bakery, Dairy/Milk, Sweets, Confectionery)."
          }
        },
        {
          "name": "2. Get Category Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/categories/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", "1", ""]
            },
            "description": "Get details of category ID 1."
          }
        },
        {
          "name": "3. Admin Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Artisanal Beverages\",\n  \"sector\": \"CONFECTIONERY\",\n  \"description\": \"Fresh organic juices, lassi, and cold beverages.\",\n  \"is_active\": true,\n  \"metadata\": {\n    \"temperature_sensitive\": true\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/categories/",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "categories", ""]
            },
            "description": "Admin endpoint to add a new category entry with sector choice and JSON metadata."
          }
        },
        {
          "name": "4. Admin Update Category",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated artisanal breads and pastries category description.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/categories/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "categories", "1", ""]
            },
            "description": "Admin endpoint to update category information."
          }
        },
        {
          "name": "5. Admin Delete Category",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/categories/5/",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "categories", "5", ""]
            },
            "description": "Admin endpoint to remove a category."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "1. List All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/",
              "host": ["{{base_url}}"],
              "path": ["api", "products", ""]
            },
            "description": "List all active products across all 4 business sectors."
          }
        },
        {
          "name": "2. Filter Products by Sector (e.g. DAIRY)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/?sector=DAIRY",
              "host": ["{{base_url}}"],
              "path": ["api", "products", ""],
              "query": [
                {
                  "key": "sector",
                  "value": "DAIRY"
                }
              ]
            },
            "description": "Filter products by sector: BAKERY, DAIRY, SWEETS, or CONFECTIONERY."
          }
        },
        {
          "name": "3. Filter Products by SKU",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/?sku=SW-DAI-001",
              "host": ["{{base_url}}"],
              "path": ["api", "products", ""],
              "query": [
                {
                  "key": "sku",
                  "value": "SW-DAI-001"
                }
              ]
            },
            "description": "Filter products by unique SKU."
          }
        },
        {
          "name": "4. Filter In-Stock Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/?in_stock=true",
              "host": ["{{base_url}}"],
              "path": ["api", "products", ""],
              "query": [
                {
                  "key": "in_stock",
                  "value": "true"
                }
              ]
            },
            "description": "Filter products that are available and in stock."
          }
        },
        {
          "name": "5. Search Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/?search=Milk",
              "host": ["{{base_url}}"],
              "path": ["api", "products", ""],
              "query": [
                {
                  "key": "search",
                  "value": "Milk"
                }
              ]
            },
            "description": "Search products matching term 'Milk' across name, description, SKU, brand, and subcategory."
          }
        },
        {
          "name": "6. Get Product Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "1", ""]
            },
            "description": "Get detailed item information."
          }
        },
        {
          "name": "7. List Products by Category ID Endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/categories/1/products/",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", "1", "products", ""]
            },
            "description": "Get products belonging to specific category."
          }
        },
        {
          "name": "8. Admin Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SW-BAK-003\",\n  \"name\": \"Butter Croissant (2 Pack)\",\n  \"category_id\": 1,\n  \"subcategory_name\": \"Pastries\",\n  \"description\": \"Flaky french butter croissants freshly baked daily.\",\n  \"price\": \"120.00\",\n  \"discount_price\": \"105.00\",\n  \"tax_percentage\": \"5.00\",\n  \"unit\": \"2 Pcs\",\n  \"stock_quantity\": 50,\n  \"is_available\": true,\n  \"is_active\": true,\n  \"brand\": \"Swastik Bakery\",\n  \"tags\": [\"fresh\", \"french-style\", \"butter\"],\n  \"attributes\": {\n    \"shelf_life_days\": 2,\n    \"heating_instruction\": \"Warm for 10 seconds in microwave\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/products/",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "products", ""]
            },
            "description": "Admin endpoint to create a new product entry with full parameters and JSON attributes."
          }
        },
        {
          "name": "9. Admin List All Products (Incl. Inactive)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/products/",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "products", ""]
            },
            "description": "Admin endpoint to list all catalog entries."
          }
        },
        {
          "name": "10. Admin Update Product",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": \"42.00\",\n  \"discount_price\": \"38.00\",\n  \"stock_quantity\": 200\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/products/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "products", "1", ""]
            },
            "description": "Admin endpoint to update product pricing, stock quantity, or information."
          }
        },
        {
          "name": "11. Admin Delete Product",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/products/9/",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "products", "9", ""]
            },
            "description": "Admin endpoint to delete a product entry."
          }
        }
      ]
    }
  ]
}
